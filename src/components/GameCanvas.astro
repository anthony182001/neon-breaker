---
// src/components/GameCanvas.astro
import UserModal from './UserModal.astro';
import Leaderboard from './Leaderboard.astro';
---

<div class="w-full flex flex-col items-center gap-8 my-4">
  <UserModal />

  <div class="w-full flex flex-col lg:flex-row gap-8 items-start justify-center max-w-5xl px-4">
    
    <div class="flex flex-col items-center w-full lg:w-auto">
      <!-- Barra del Marcador con Indicador de Nivel -->
      <div class="flex justify-between items-center w-full max-w-[500px] mb-4 px-5 py-3 bg-zinc-950/90 border border-yellow-500/30 rounded-xl text-xs sm:text-sm font-mono shadow-md">
        <span class="text-yellow-400/90">OPERADOR: <strong id="display-player" class="text-white font-bold">---</strong></span>
        <span class="text-yellow-400/90">NIVEL: <strong id="display-level" class="text-yellow-400 font-bold">1</strong></span>
        <span class="text-yellow-400/90">PUNTOS: <strong id="display-score" class="text-white font-bold">0</strong></span>
        <span class="text-yellow-400/90">VIDAS: <strong id="display-lives" class="text-white font-bold">3</strong></span>
        
        <button 
          id="logout-btn" 
          title="Cerrar Sesión"
          class="text-red-400 hover:text-red-300 hover:bg-red-950/40 px-2 py-1 rounded border border-red-500/30 transition text-xs flex items-center gap-1 cursor-pointer"
        >
          <span>✕</span> Salir
        </button>
      </div>

      <div class="relative max-w-[500px] w-full overflow-hidden rounded-2xl border-2 border-yellow-400 shadow-[0_0_30px_rgba(250,204,21,0.15)] bg-black">
        
        <!-- ESCUDO DE ECUADOR 8-BIT DE ALTA DEFINICIÓN RETRO (32x32 GRID) -->
        <div class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-30 select-none p-4">
          <svg 
            class="w-full h-full max-w-[320px] drop-shadow-[0_0_12px_rgba(250,204,21,0.2)]" 
            viewBox="0 0 32 32" 
            fill="currentColor" 
            style="image-rendering: pixelated;"
          >
            <!-- 1. CÓNDOR (Alas expandidas y cabeza) -->
            <rect x="14" y="1" width="4" height="2" fill="#eab308"/>
            <rect x="13" y="2" width="6" height="3" fill="#3f3f46"/>
            <rect x="14" y="3" width="4" height="1" fill="#ffffff"/>
            
            <!-- Alas del Cóndor -->
            <rect x="3" y="3" width="10" height="2" fill="#27272a"/>
            <rect x="19" y="3" width="10" height="2" fill="#27272a"/>
            <rect x="1" y="5" width="13" height="2" fill="#3f3f46"/>
            <rect x="18" y="5" width="13" height="2" fill="#3f3f46"/>
            <rect x="0" y="7" width="14" height="2" fill="#18181b"/>
            <rect x="18" y="7" width="14" height="2" fill="#18181b"/>

            <!-- 2. BANDERAS LATERALES (Tricolor) -->
            <rect x="2" y="9" width="3" height="15" fill="#facc15"/>
            <rect x="3" y="10" width="3" height="15" fill="#0284c7"/>
            <rect x="4" y="11" width="3" height="15" fill="#f43f5e"/>
            <rect x="1" y="9" width="1" height="18" fill="#9ca3af"/>

            <rect x="27" y="9" width="3" height="15" fill="#facc15"/>
            <rect x="26" y="10" width="3" height="15" fill="#0284c7"/>
            <rect x="25" y="11" width="3" height="15" fill="#f43f5e"/>
            <rect x="30" y="9" width="1" height="18" fill="#9ca3af"/>

            <!-- 3. ÓVALO CENTRAL -->
            <rect x="7" y="8" width="18" height="16" fill="#ca8a04"/>
            <rect x="8" y="9" width="16" height="14" fill="#000000"/>

            <!-- 4. PAISAJE INTERIOR -->
            <rect x="8" y="9" width="16" height="5" fill="#0ea5e9"/>
            
            <!-- Sol -->
            <rect x="15" y="10" width="2" height="2" fill="#facc15"/>
            <rect x="14" y="9" width="4" height="1" fill="#fde047"/>
            <rect x="14" y="12" width="4" height="1" fill="#fde047"/>
            <rect x="13" y="10" width="1" height="2" fill="#fde047"/>
            <rect x="18" y="10" width="1" height="2" fill="#fde047"/>

            <!-- Chimborazo -->
            <rect x="14" y="13" width="4" height="2" fill="#ffffff"/>
            <rect x="12" y="15" width="8" height="2" fill="#f8fafc"/>
            <rect x="10" y="17" width="12" height="2" fill="#15803d"/>

            <!-- Río Guayas -->
            <rect x="8" y="19" width="16" height="4" fill="#0284c7"/>
            
            <!-- Buque -->
            <rect x="14" y="20" width="5" height="2" fill="#facc15"/>
            <rect x="13" y="21" width="7" height="1" fill="#991b1b"/>
            <rect x="16" y="18" width="1" height="2" fill="#ffffff"/>

            <!-- 5. FASCES Y HACHA -->
            <rect x="9" y="24" width="14" height="2" fill="#b45309"/>
            <rect x="6" y="24" width="3" height="2" fill="#e5e7eb"/>
            
            <!-- Lazos -->
            <rect x="12" y="26" width="2" height="5" fill="#facc15"/>
            <rect x="15" y="26" width="2" height="5" fill="#0284c7"/>
            <rect x="18" y="26" width="2" height="5" fill="#f43f5e"/>
            
            <!-- Ramas -->
            <rect x="7" y="22" width="2" height="4" fill="#16a34a"/>
            <rect x="23" y="22" width="2" height="4" fill="#16a34a"/>
          </svg>
        </div>

        <!-- CANVAS DEL JUEGO -->
        <canvas 
          id="breakout-canvas" 
          width="500" 
          height="360" 
          class="relative z-10 w-full bg-transparent cursor-none block"
        ></canvas>
        
        <!-- Pantalla de Transición: Nivel Completado -->
        <div id="level-complete-screen" class="hidden absolute inset-0 z-20 bg-black/90 backdrop-blur-md flex flex-col items-center justify-center space-y-4 p-6 text-center">
          <div class="px-3 py-0.5 bg-green-500 text-black font-extrabold text-[10px] tracking-widest uppercase font-mono rounded animate-pulse">
            SECTOR LIMPIADO
          </div>
          
          <h4 class="text-2xl font-black text-green-400 font-mono">¡NIVEL COMPLETADO!</h4>
          <p class="text-zinc-300 font-mono text-sm">Prepárate para la siguiente fase.</p>
          
          <button id="next-level-btn" class="px-8 py-3 bg-green-500 text-black font-black rounded-full hover:bg-green-400 transition duration-300 font-mono uppercase shadow-lg shadow-green-500/30 text-sm cursor-pointer">
            SIGUIENTE NIVEL ➔
          </button>
        </div>

        <!-- Pantalla de Fin de Juego Dinámica -->
        <div id="game-over-screen" class="hidden absolute inset-0 z-20 bg-black/95 backdrop-blur-md flex flex-col items-center justify-center space-y-4 p-6 text-center">
          
          <!-- PERSONAJE 8-BIT: VICTORIA -->
          <div id="avatar-win" class="hidden animate-bounce">
            <svg class="w-20 h-20 text-yellow-400 drop-shadow-[0_0_10px_rgba(250,204,21,0.8)]" viewBox="0 0 16 16" fill="currentColor" style="image-rendering: pixelated;">
              <rect x="3" y="1" width="2" height="2"/>
              <rect x="7" y="1" width="2" height="2"/>
              <rect x="11" y="1" width="2" height="2"/>
              <rect x="3" y="3" width="10" height="1"/>
              <rect x="2" y="4" width="12" height="10"/>
              <rect x="4" y="6" width="2" height="2" fill="#000"/>
              <rect x="10" y="6" width="2" height="2" fill="#000"/>
              <rect x="4" y="10" width="2" height="2" fill="#000"/>
              <rect x="6" y="11" width="4" height="2" fill="#000"/>
              <rect x="10" y="10" width="2" height="2" fill="#000"/>
            </svg>
          </div>

          <!-- PERSONAJE 8-BIT: DERROTA -->
          <div id="avatar-lose" class="hidden animate-pulse">
            <svg class="w-20 h-20 text-red-500 drop-shadow-[0_0_10px_rgba(239,68,68,0.8)]" viewBox="0 0 16 16" fill="currentColor" style="image-rendering: pixelated;">
              <rect x="4" y="1" width="8" height="2"/>
              <rect x="2" y="3" width="12" height="8"/>
              <rect x="4" y="5" width="1" height="1" fill="#000"/>
              <rect x="6" y="5" width="1" height="1" fill="#000"/>
              <rect x="5" y="6" width="1" height="1" fill="#000"/>
              <rect x="4" y="7" width="1" height="1" fill="#000"/>
              <rect x="6" y="7" width="1" height="1" fill="#000"/>
              <rect x="9" y="5" width="1" height="1" fill="#000"/>
              <rect x="11" y="5" width="1" height="1" fill="#000"/>
              <rect x="10" y="6" width="1" height="1" fill="#000"/>
              <rect x="9" y="7" width="1" height="1" fill="#000"/>
              <rect x="11" y="7" width="1" height="1" fill="#000"/>
              <rect x="4" y="9" width="8" height="1" fill="#000"/>
              <rect x="3" y="11" width="10" height="3"/>
              <rect x="5" y="11" width="2" height="3" fill="#000"/>
              <rect x="9" y="11" width="2" height="3" fill="#000"/>
            </svg>
          </div>

          <div id="game-status-badge" class="px-3 py-0.5 bg-yellow-400 text-black font-extrabold text-[10px] tracking-widest uppercase font-mono rounded">
            ESTADO DE MISIÓN
          </div>
          
          <h4 id="game-status-title" class="text-2xl font-black text-yellow-400 font-mono">PELIGRO CRÍTICO</h4>
          <p class="text-zinc-400 font-mono text-sm">Puntaje Final: <span id="final-score" class="text-yellow-400 font-bold text-lg">0</span></p>
          
          <button id="restart-btn" class="px-8 py-3 bg-yellow-400 text-black font-black rounded-full hover:bg-yellow-300 transition duration-300 font-mono uppercase shadow-lg shadow-yellow-400/30 text-sm cursor-pointer">
            REINTENTAR
          </button>
        </div>

      </div>
    </div>

    <Leaderboard />

  </div>
</div>

<script>
  import { BreakoutGame, savePlayerScore } from '../utils/breakoutGame';

  const canvas = document.getElementById('breakout-canvas') as HTMLCanvasElement;
  const logoutBtn = document.getElementById('logout-btn');
  const gameOverScreen = document.getElementById('game-over-screen');
  const levelCompleteScreen = document.getElementById('level-complete-screen');
  const nextLevelBtn = document.getElementById('next-level-btn');
  const gameStatusTitle = document.getElementById('game-status-title');
  const gameStatusBadge = document.getElementById('game-status-badge');
  const avatarWin = document.getElementById('avatar-win');
  const avatarLose = document.getElementById('avatar-lose');

  if (canvas) {
    const game = new BreakoutGame({
      canvas,
      displayScore: document.getElementById('display-score'),
      displayLives: document.getElementById('display-lives'),
      displayLevel: document.getElementById('display-level'),
      gameOverScreen,
      levelCompleteScreen,
      gameStatusTitle,
      finalScoreText: document.getElementById('final-score'),
      getPlayerName: () => localStorage.getItem('breakout_player_name') || 'ANÓNIMO',
      onScoreSave: async (score, levelReached) => {
        // Pasa el score y el nivel alcanzado a Turso
        await savePlayerScore(score, levelReached);
      }
    });

    if (gameOverScreen && gameStatusTitle) {
      const observer = new MutationObserver(() => {
        if (!gameOverScreen.classList.contains('hidden')) {
          const text = gameStatusTitle.textContent?.toUpperCase() || '';
          const isVictory = text.includes('VICTORIA') || text.includes('GANASTE') || text.includes('COMPLETADO');

          if (isVictory) {
            avatarWin?.classList.remove('hidden');
            avatarLose?.classList.add('hidden');
            if (gameStatusBadge) {
              gameStatusBadge.textContent = 'MISIÓN CUMPLIDA';
              gameStatusBadge.className = 'px-3 py-0.5 bg-yellow-400 text-black font-extrabold text-[10px] tracking-widest uppercase font-mono rounded';
            }
          } else {
            avatarLose?.classList.remove('hidden');
            avatarWin?.classList.add('hidden');
            if (gameStatusBadge) {
              gameStatusBadge.textContent = 'LE FALLASTE A LA PATRIA';
              gameStatusBadge.className = 'px-3 py-0.5 bg-red-500 text-white font-extrabold text-[10px] tracking-widest uppercase font-mono rounded';
            }
          }
        }
      });

      observer.observe(gameOverScreen, { attributes: true, attributeFilter: ['class'] });
    }

    // Event listeners de interacción
    nextLevelBtn?.addEventListener('click', () => {
      game.nextLevel();
    });

    logoutBtn?.addEventListener('click', () => {
      localStorage.removeItem('breakout_user_id');
      localStorage.removeItem('breakout_player_name');
      localStorage.removeItem('breakout_player_email');
      
      const displayPlayer = document.getElementById('display-player');
      if (displayPlayer) displayPlayer.textContent = '---';

      window.dispatchEvent(new Event('logout-event'));
    });

    document.getElementById('restart-btn')?.addEventListener('click', () => game.reset());
    game.draw();
  }
</script>