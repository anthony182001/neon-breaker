---
// src/components/UserModal.astro
---
<div id="user-modal" class="fixed inset-0 bg-black/95 backdrop-blur-sm z-50 flex items-center justify-center p-6">
  <div class="bg-zinc-950 border-2 border-yellow-400 p-8 rounded-2xl max-w-md w-full shadow-[0_0_40px_rgba(250,204,21,0.2)] text-center space-y-5">
    <div class="inline-block px-3 py-1 bg-yellow-400 text-black font-extrabold text-xs tracking-widest uppercase font-mono rounded">
      ACCESO AL SISTEMA
    </div>
    <h3 class="text-2xl font-black text-yellow-400 font-mono tracking-wider">
      INICIAR SESIÓN
    </h3>
    <p class="text-zinc-400 text-sm leading-relaxed">
      Ingresa tus datos para identificarte y registrar tus puntos en el ranking.
    </p>

    <!-- Corregido el id del formulario -->
    <form id="user-form" class="space-y-4">
      <div>
        <label class="block text-left text-xs font-mono text-yellow-400/80 mb-1 uppercase">Correo Electrónico</label>
        <input 
          type="email" 
          name="email" 
          id="player-email-input" 
          placeholder="operador@dev.com" 
          required
          class="w-full px-4 py-2.5 bg-black border border-yellow-500/40 rounded-xl text-yellow-400 font-mono focus:border-yellow-400 focus:outline-none placeholder-zinc-600 transition text-sm"
        />
      </div>

      <div>
        <label class="block text-left text-xs font-mono text-yellow-400/80 mb-1 uppercase">Nombre de Usuario / Nick</label>
        <input 
          type="text" 
          name="name" 
          id="player-name-input" 
          placeholder="HAZARD_DEV" 
          maxlength="12"
          required
          class="w-full px-4 py-2.5 bg-black border border-yellow-500/40 rounded-xl text-yellow-400 font-mono focus:border-yellow-400 focus:outline-none placeholder-zinc-600 transition text-sm"
        />
      </div>

      <!-- Corregido el id del mensaje de error -->
      <div id="user-error" class="text-red-400 text-xs font-mono hidden"></div>

      <button 
        type="submit"
        id="submit-btn"
        class="w-full py-3 bg-yellow-400 hover:bg-yellow-300 text-black font-black rounded-xl transition duration-300 shadow-lg shadow-yellow-400/20 font-mono uppercase tracking-wider text-sm mt-2 disabled:opacity-50 cursor-pointer"
      >
        INGRESAR AL JUEGO
      </button>
    </form>
  </div>
</div>

<script>
  const modal = document.getElementById('user-modal');
  const form = document.getElementById('user-form') as HTMLFormElement;
  const errorMsg = document.getElementById('user-error');
  const displayPlayer = document.getElementById('display-player');

  function checkUserSession() {
    const userId = localStorage.getItem('breakout_user_id');
    const playerName = localStorage.getItem('breakout_player_name');

    if (userId && playerName) {
      modal?.classList.add('hidden');
      if (displayPlayer) displayPlayer.textContent = playerName.toUpperCase();
    } else {
      modal?.classList.remove('hidden');
    }
  }

  // Verificar sesión al cargar
  checkUserSession();

  // Escuchar cuando cerramos sesión
  window.addEventListener('logout-event', () => {
    checkUserSession();
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (errorMsg) {
      errorMsg.textContent = '';
      errorMsg.classList.add('hidden');
    }

    const formData = new FormData(form);
    const email = formData.get('email')?.toString().trim();
    const name = formData.get('name')?.toString().trim();

    if (!email || !name) {
      if (errorMsg) {
        errorMsg.textContent = 'Por favor completa todos los campos.';
        errorMsg.classList.remove('hidden');
      }
      return;
    }

    try {
      const res = await fetch('/api/users', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, name })
      });

      const data = await res.json();

      if (res.ok && data.id) {
        // Guardar sesión en LocalStorage
        localStorage.setItem('breakout_user_id', String(data.id));
        localStorage.setItem('breakout_player_name', data.name);
        localStorage.setItem('breakout_player_email', data.email);

        if (displayPlayer) displayPlayer.textContent = data.name.toUpperCase();
        modal?.classList.add('hidden');
      } else {
        if (errorMsg) {
          errorMsg.textContent = data.error || 'No se pudo iniciar sesión.';
          errorMsg.classList.remove('hidden');
        }
      }
    } catch (err) {
      console.error(err);
      if (errorMsg) {
        errorMsg.textContent = 'Error al conectar con la base de datos.';
        errorMsg.classList.remove('hidden');
      }
    }
  });
</script>